GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Set to true to always use the bundled sample lesson (no Gemini calls)
USE_MOCK_DATA=false
GEMINI_FALLBACK_MODEL=gemini-flash-lite-latest

# MongoDB (server-only, never expose to the browser)
MONGODB_URI=
# Optional: database name, if not already the default in MONGODB_URI
MONGODB_DB=ilumo

# Signs and verifies login sessions. Generate one with: openssl rand -base64 32
JWT_SECRET=
